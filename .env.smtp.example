# Copie para .env.smtp.local (ignorado pelo Git) e preencha localmente.
# Gmail: preencha seu endereço em USERNAME e FROM_ADDRESS.
# PASSWORD recebe uma senha de aplicativo Google, não sua senha de login.
# FRONTEND_BASE_URL: http://localhost:3000 no Docker Compose; http://localhost:5173 com o Vite local.
# Guia completo: _mds/ATUALIZACOES/2026-11-06.md (seção "Guia do SMTP com Gmail").
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FRONTEND_BASE_URL=http://localhost:3000
